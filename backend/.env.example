# Anthropic API key — never commit the real value.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for every correction/generation call. Kept as a variable so it
# can be bumped without touching code.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# SQLite file path (relative to backend/ when run locally, absolute inside Docker).
DATABASE_PATH=./app/data/app.db

# Vector DB (pgvector on Postgres) — start it with `docker compose up -d vector_db`.
VECTOR_DB_URL=postgresql://ise2:ise2@localhost:5433/ise2_vectors

# Local embedding model (sentence-transformers), no external API needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Folder with your own PDFs/notes to ingest for RAG (relative to backend/ locally,
# mounted at /context inside Docker).
CONTEXT_DIR=../context
